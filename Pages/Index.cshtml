@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "Srinivasan Dhakshanamoorthy is a Paris-based .NET Engineer and Data/AI Specialist with 8+ years of enterprise experience across banking, logistics, cloud, ETL, and applied AI.";
}

<div class="hero-bg"></div>


<section class="hero">

    <div class="hero-glow"></div>


    <div style="position:relative;z-index:2;">

        <div class="avail-badge">
            <span class="avail-dot"></span>
            <span class="en-text">Available · Paris, France · All work modes</span>
            <span class="fr-text">Disponible · Paris, France · Tous modes</span>
        </div>

        <p class="hero-greeting">Hello, I'm<span class="dot"> .</span></p>
        <p class="hero-name">Srinivasan Dhakshanamoorthy</p>

        <h1 class="hero-title hero-title-animate">
            <span class="en-text">.NET Engineer &amp;<br>Data/AI Specialist</span>
            <span class="fr-text">Ingénieur .NET &amp;<br>Data / IA</span>
        </h1>

        <div class="pivot-badge">
            <span class="en-text">8+ yrs Backend Engineer → Data &amp; AI Engineer · Paris · Available now</span>
            <span class="fr-text">8+ ans Ingénieur Backend → Data &amp; IA · Paris · Disponible</span>
        </div>

        <div class="fast-scan" aria-label="Recruiter summary">
            <div class="fast-scan-item">
                <span class="fast-scan-k">Status</span>
                <span class="fast-scan-v">
                    <span class="en-text">Available now</span>
                    <span class="fr-text">Disponible</span>
                </span>
            </div>
            <div class="fast-scan-item">
                <span class="fast-scan-k">Location</span>
                <span class="fast-scan-v">Paris / Remote</span>
            </div>
            <div class="fast-scan-item">
                <span class="fast-scan-k">Roles</span>
                <span class="fast-scan-v">.NET · Data · AI</span>
            </div>
            <div class="fast-scan-item">
                <span class="fast-scan-k">Modes</span>
                <span class="fast-scan-v">Stage · CDI · Freelance</span>
            </div>
            <div class="fast-scan-item">
                <span class="fast-scan-k">Languages</span>
                <span class="fast-scan-v">English C1 · French A2</span>
            </div>
        </div>


        <div class="co-boxes">
            <div class="co-box">
                <div class="co-logo">🏦</div>
                <div>
                    <div class="co-name">Bank of America</div>
                    <div class="co-meta">Feb 2022 – Sep 2025 · Chennai</div>
                </div>
            </div>
            <div class="co-box">
                <div class="co-logo">🔷</div>
                <div>
                    <div class="co-name">Cognizant</div>
                    <div class="co-meta">May 2014 – Feb 2022 · Chennai</div>
                </div>
            </div>
            <div class="co-box">
                <div class="co-logo">💼</div>
                <div>
                    <div class="co-name">LTI Mindtree</div>
                    <div class="co-meta">Jul 2017 – Jul 2019 · Bangalore</div>
                </div>
            </div>
            <div class="co-box">
                <div class="co-logo">🎓</div>
                <div>
                    <div class="co-name">ESILV Paris</div>
                    <div class="co-meta">
                        <span class="en-text">M.Sc. Data Engineering &amp; AI · 2025–2026</span>
                        <span class="fr-text">Master Data Eng. &amp; IA · 2025–2026</span>
                    </div>
                </div>
            </div>
        </div>


        <div class="skill-tags">
            <span class="skill-tag tag-indigo">ASP.NET Core</span>
            <span class="skill-tag tag-indigo">C#</span>
            <span class="skill-tag tag-indigo">REST APIs</span>
            <span class="skill-tag tag-indigo">SQL Server</span>
            <span class="skill-tag tag-rose">Azure</span>
            <span class="skill-tag tag-rose">Docker</span>
            <span class="skill-tag tag-rose">CI/CD</span>
            <span class="skill-tag tag-teal">Python</span>
            <span class="skill-tag tag-teal">ETL</span>
            <span class="skill-tag tag-teal">Pandas</span>
            <span class="skill-tag tag-purple">BERT / NLP</span>
            <span class="skill-tag tag-purple">LangChain</span>
        </div>

        <p class="hero-desc">
            <span class="en-text">
                Senior .NET Engineer with <strong>8+ years</strong> delivering enterprise-grade systems
                across banking &amp; logistics at Bank of America and Cognizant — expert in
                C#, ASP.NET Core, REST APIs, and Azure cloud. Now completing
                <strong>M.Sc. Data Engineering &amp; AI at ESILV Paris (2026)</strong>.
                Immediately available for .NET, Full Stack, or Data roles in Europe.
            </span>
            <span class="fr-text">
                Ingénieur .NET Senior avec <strong>8+ ans</strong> chez Bank of America et Cognizant —
                expert C#, ASP.NET Core, REST APIs et Azure. En Master Data &amp; IA à l'<strong>ESILV Paris (2026)</strong>.
                Disponible immédiatement pour des rôles .NET, Full Stack ou Data en France &amp; Europe.
            </span>
        </p>

        <div class="hero-btns">
            <a class="btn-primary" asp-page="/Projects">
                <span class="en-text">View Projects →</span>
                <span class="fr-text">Voir mes projets →</span>
            </a>
            <a class="btn-ghost" asp-page="/About">
                <span class="en-text">About Me</span>
                <span class="fr-text">À propos</span>
            </a>
        </div>
    </div>


    <div class="hero-visual">
        <div class="vis-wrap">

            <div class="orbit orbit-1"></div>
            <div class="orbit orbit-2"></div>


            <div class="photo-card">
                <img src="~/images/profile.jpeg" alt="Srinivasan Dhakshanamoorthy" />
                <div class="exp-badge">8+ yrs enterprise</div>
            </div>


            <div class="otw-ring">
                <svg viewBox="0 0 50 50" width="50" height="50">
                    <path id="otwPath" d="M 25,3 A 22,22 0 1,1 24.99,3" fill="none"/>
                    <text font-family="Space Mono,monospace" font-size="5.5" fill="#C0392B" font-weight="700" letter-spacing="1.5">
                        <textPath href="#otwPath">OPEN TO WORK • PARIS • 2026 •</textPath>
                    </text>
                </svg>
                <div class="otw-center"></div>
            </div>


            <div class="skill-chip chip-1">
                <div class="chip-inner">
                    <div class="chip-icon" style="background:#EEF2FF;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="#4F46E5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div>
                        <span class="chip-label">.NET Backend</span>
                        <span class="chip-sub">ASP.NET Core · C#</span>
                    </div>
                </div>
                <div class="chip-bar"><div class="chip-fill" style="width:92%;background:#4F46E5;"></div></div>
                <div class="chip-tooltip">
                    <div class="tt-title">Backend Engineering</div>
                    8+ years building enterprise APIs at Bank of America &amp; Cognizant. 500K+ daily transactions.
                    <div class="tt-tags"><span class="tt-tag">ASP.NET Core</span><span class="tt-tag">C#</span><span class="tt-tag">EF Core</span><span class="tt-tag">CQRS</span></div>
                    <div class="tt-stat">100K+ users · 40+ endpoints · 0 incidents</div>
                </div>
            </div>


            <div class="skill-chip chip-2">
                <div class="chip-inner">
                    <div class="chip-icon" style="background:#EFF6FF;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" stroke="#2563EB" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div>
                        <span class="chip-label">Azure Cloud</span>
                        <span class="chip-sub">DevOps · Docker</span>
                    </div>
                </div>
                <div class="chip-bar"><div class="chip-fill" style="width:85%;background:#2563EB;"></div></div>
                <div class="chip-tooltip">
                    <div class="tt-title">Cloud &amp; DevOps</div>
                    Full Azure stack — App Services, Functions, DevOps CI/CD. Cut release cycles by 40%.
                    <div class="tt-tags"><span class="tt-tag">Azure</span><span class="tt-tag">Docker</span><span class="tt-tag">GitHub Actions</span></div>
                    <div class="tt-stat">Blue/green deployments · IIS · SonarQube</div>
                </div>
            </div>


            <div class="skill-chip chip-3">
                <div class="chip-inner">
                    <div class="chip-icon" style="background:#F0FDF4;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><ellipse cx="12" cy="5" rx="9" ry="3" stroke="#16A34A" stroke-width="2"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" stroke="#16A34A" stroke-width="2"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" stroke="#16A34A" stroke-width="2"/></svg>
                    </div>
                    <div>
                        <span class="chip-label">Data Engineering</span>
                        <span class="chip-sub">Python · SQL · ETL</span>
                    </div>
                </div>
                <div class="chip-bar"><div class="chip-fill" style="width:80%;background:#16A34A;"></div></div>
                <div class="chip-tooltip">
                    <div class="tt-title">Data Engineering</div>
                    SSIS pipelines, 3M+ records/day. M.Sc. Data Engineering &amp; AI at ESILV Paris (2026).
                    <div class="tt-tags"><span class="tt-tag">Python</span><span class="tt-tag">Pandas</span><span class="tt-tag">Spark</span><span class="tt-tag">ETL</span></div>
                    <div class="tt-stat">ESILV Paris · Graduating 2026</div>
                </div>
            </div>


            <div class="skill-chip chip-4">
                <div class="chip-inner">
                    <div class="chip-icon" style="background:#FDF4FF;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V17a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 0 1 7-7z" stroke="#9333EA" stroke-width="2"/><path d="M9 21h6" stroke="#9333EA" stroke-width="2" stroke-linecap="round"/></svg>
                    </div>
                    <div>
                        <span class="chip-label">AI &amp; NLP</span>
                        <span class="chip-sub">BERT · LangChain</span>
                    </div>
                </div>
                <div class="chip-bar"><div class="chip-fill" style="width:74%;background:#9333EA;"></div></div>
                <div class="chip-tooltip">
                    <div class="tt-title">AI &amp; NLP</div>
                    Fine-tuned BERT for sentiment analysis. GenAI apps with LangChain + OpenAI RAG pipelines.
                    <div class="tt-tags"><span class="tt-tag">BERT</span><span class="tt-tag">HuggingFace</span><span class="tt-tag">LangChain</span><span class="tt-tag">RAG</span></div>
                    <div class="tt-stat">Computer Vision · LLMs · MLflow</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator" aria-hidden="true">
        <span class="scroll-indicator-text">scroll</span>
        <div class="scroll-indicator-line"></div>
    </div>

</section>


<div class="skills-ticker">
    <div class="ticker-track">
        @{var skills = new[]{"C#","ASP.NET Core","Python","Azure","SQL Server","BERT / NLP","Docker","Entity Framework","OAuth 2.0","LangChain","Pandas","Spark","GitHub Actions","MLflow","Scikit-learn","LTI Mindtree","Bank of America","Cognizant","ESILV Paris"}; }
        @foreach(var s in skills){ <div class="ticker-item"><span class="ticker-dot"></span>@s</div> }
        @foreach(var s in skills){ <div class="ticker-item"><span class="ticker-dot"></span>@s</div> }
    </div>
</div>


<div class="stats-row reveal">
    <div class="stat-card">
        <span class="stat-num">8+</span>
        <span class="stat-lbl">
            <span class="en-text">Years Enterprise<br>Experience</span>
            <span class="fr-text">Ans d'expérience<br>entreprise</span>
        </span>
    </div>
    <div class="stat-card">
        <span class="stat-num" style="color:#E31837;">BoA</span>
        <span class="stat-lbl">
            <span class="en-text"><strong>Bank of America</strong><br>Senior Tech Lead</span>
            <span class="fr-text"><strong>Bank of America</strong><br>Tech Lead Senior</span>
        </span>
    </div>
    <div class="stat-card">
        <span class="stat-num" style="color:#0033A0;">CGN</span>
        <span class="stat-lbl">
            <span class="en-text"><strong>Cognizant</strong><br>Senior Associate</span>
            <span class="fr-text"><strong>Cognizant</strong><br>Senior Associate</span>
        </span>
    </div>
    <div class="stat-card">
        <span class="stat-num" style="color:#007A4D;">LTI</span>
        <span class="stat-lbl">
            <span class="en-text"><strong>LTI Mindtree</strong><br>Senior Engineer</span>
            <span class="fr-text"><strong>LTI Mindtree</strong><br>Ingénieur Senior</span>
        </span>
    </div>
    <div class="stat-card">
        <span class="stat-num">ESILV</span>
        <span class="stat-lbl">
            <span class="en-text">M.Sc. Data Eng &amp; AI<br>Paris · 2026</span>
            <span class="fr-text">Master Data Eng &amp; IA<br>Paris · 2026</span>
        </span>
    </div>
    <div class="stat-card">
        <span class="stat-num" style="font-size:1rem;">→ AI</span>
        <span class="stat-lbl">
            <span class="en-text">Pivoting to<br>Data / AI &amp; Cloud</span>
            <span class="fr-text">Reconversion<br>Data / IA &amp; Cloud</span>
        </span>
    </div>
</div>

<div class="divider" style="margin-top:0;"></div>
