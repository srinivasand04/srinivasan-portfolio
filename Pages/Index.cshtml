@page
@model IndexModel
@{ ViewData["Title"] = "Home"; }

<div class="hero-bg"></div>

<!-- ══ HERO ══════════════════════════════════════════════════ -->
<section style="max-width:1200px;margin:0 auto;padding:60px 5% 50px;min-height:calc(100vh - 64px);display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;position:relative;">

    <div class="hero-glow"></div>

    <!-- LEFT — Text -->
    <div style="position:relative;z-index:2;">
        <div class="avail-badge">
            <span class="avail-dot"></span>
            <span class="en-text">Available · Paris · Internship &amp; Full-time</span>
            <span class="fr-text">Disponible · Paris · Stage &amp; CDI</span>
        </div>
        <p class="hero-greeting">Hello<span class="dot"> .</span></p>
        <p class="hero-name">
            <span class="en-text">I'm Srinivasan Dhakshanamoorthy</span>
            <span class="fr-text">Je suis Srinivasan Dhakshanamoorthy</span>
        </p>
        <h1 class="hero-title">
            <span class="en-text">.NET Developer &amp;<br>Data Engineer</span>
            <span class="fr-text">Développeur .NET &amp;<br>Ingénieur Data</span>
        </h1>
        <p class="hero-desc">
            <span class="en-text">Building scalable web applications, intelligent data pipelines, and AI-powered solutions — deployed end-to-end on Azure. Based in Paris, open to internship and full-time roles across France &amp; Europe.</span>
            <span class="fr-text">Je développe des applications web scalables, des pipelines de données intelligents et des solutions IA — déployées sur Azure. Basé à Paris, disponible pour un stage ou un CDI en France et en Europe.</span>
        </p>
        <div class="hero-btns">
            <a class="btn-primary" asp-page="/Projects">
                <span class="en-text">View Projects →</span>
                <span class="fr-text">Voir mes projets →</span>
            </a>
            <a class="btn-ghost" asp-page="/About">
                <span class="en-text">About Me</span>
                <span class="fr-text">À propos</span>
            </a>
        </div>
    </div>

    <!-- RIGHT — Interactive Visual -->
    <div class="hero-visual">
        <div class="vis-wrap">
            <!-- Orbit rings -->
            <div class="orbit orbit-1"></div>
            <div class="orbit orbit-2"></div>

            <!-- Code card -->
            <div class="code-card">
                <div class="cc-header">
                    <div class="win-dot" style="background:#ff5f57"></div>
                    <div class="win-dot" style="background:#febc2e"></div>
                    <div class="win-dot" style="background:#28c840"></div>
                    <span class="cc-title">srinivasan.cs — portfolio</span>
                </div>
                <div class="cc-code">
                    <div class="code-line"><span class="ln">1</span><span class="t kw">public class</span><span class="t fn"> Developer</span></div>
                    <div class="code-line"><span class="ln">2</span><span class="t op">{</span></div>
                    <div class="code-line"><span class="ln">3</span><span class="t cm">&nbsp; // Paris 🇫🇷 · Open to work</span></div>
                    <div class="code-line"><span class="ln">4</span><span class="t kw">&nbsp; string</span><span class="t op"> Stack = </span><span class="t str">".NET + React"</span><span class="t op">;</span></div>
                    <div class="code-line"><span class="ln">5</span><span class="t kw">&nbsp; string</span><span class="t op"> Goal = </span><span class="t str">"Stage / CDI"</span><span class="t op">;</span></div>
                    <div class="code-line"><span class="ln">6</span><span class="t kw">&nbsp; bool</span><span class="t op"> Available = </span><span class="t str">true</span><span class="t op">;</span></div>
                    <div class="code-line"><span class="ln">7</span><span class="t fn">&nbsp; Deploy</span><span class="t op">(</span><span class="t str">"Azure"</span><span class="t op">);<span class="cursor"></span></span></div>
                    <div class="code-line"><span class="ln">8</span><span class="t op">}</span></div>
                </div>
                <div class="cc-term">
                    <div class="term-line">
                        <span class="t-prompt">sri</span>
                        <span class="t-path">:~/portfolio</span>
                        <span class="t-cmd">$ az webapp up</span>
                    </div>
                    <div class="term-out">✓ Live → srinivasand.com</div>
                </div>
                <div class="cc-profile">
                    <div class="cc-avatar">SD</div>
                    <div>
                        <div class="cc-name">Srinivasan D.</div>
                        <div class="cc-role">.NET · Data · AI · Paris</div>
                    </div>
                    <div class="cc-status">
                        <div class="status-dot"></div>
                        <span class="status-text">open</span>
                    </div>
                </div>
                <!-- Rotating OTW ring -->
                <div class="otw-ring">
                    <svg viewBox="0 0 50 50" width="50" height="50">
                        <path id="otwPath" d="M 25,3 A 22,22 0 1,1 24.99,3" fill="none"/>
                        <text font-family="Space Mono,monospace" font-size="5.5" fill="#C0392B" font-weight="700" letter-spacing="1.5">
                            <textPath href="#otwPath">OPEN TO WORK • PARIS • 2026 •</textPath>
                        </text>
                    </svg>
                    <div class="otw-center"></div>
                </div>
                <div class="exp-badge">8+ yrs enterprise</div>
            </div>

            <!-- Skill Chip 1 — .NET Backend -->
            <div class="skill-chip chip-1">
                <div class="chip-inner">
                    <div class="chip-icon" style="background:#EEF2FF;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="#4F46E5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div>
                        <span class="chip-label">.NET Backend</span>
                        <span class="chip-sub">ASP.NET Core · C#</span>
                    </div>
                </div>
                <div class="chip-bar"><div class="chip-fill" style="width:92%;background:#4F46E5;"></div></div>
                <div class="chip-tooltip">
                    <div class="tt-title">Backend Engineering</div>
                    8+ years building enterprise APIs at Bank of America &amp; Cognizant. 500K+ daily transactions with zero downtime.
                    <div class="tt-tags">
                        <span class="tt-tag">ASP.NET Core</span><span class="tt-tag">C#</span>
                        <span class="tt-tag">EF Core</span><span class="tt-tag">REST</span><span class="tt-tag">CQRS</span>
                    </div>
                    <div class="tt-stat">100K+ users · 40+ secured endpoints · 0 incidents</div>
                </div>
            </div>

            <!-- Skill Chip 2 — Azure -->
            <div class="skill-chip chip-2">
                <div class="chip-inner">
                    <div class="chip-icon" style="background:#EFF6FF;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" stroke="#2563EB" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div>
                        <span class="chip-label">Azure Cloud</span>
                        <span class="chip-sub">DevOps · Docker</span>
                    </div>
                </div>
                <div class="chip-bar"><div class="chip-fill" style="width:85%;background:#2563EB;"></div></div>
                <div class="chip-tooltip">
                    <div class="tt-title">Cloud &amp; DevOps</div>
                    Full Azure stack — App Services, Functions, DevOps CI/CD. Cut release cycles by 40% at Bank of America.
                    <div class="tt-tags">
                        <span class="tt-tag">Azure</span><span class="tt-tag">Docker</span>
                        <span class="tt-tag">GitHub Actions</span><span class="tt-tag">Jenkins</span>
                    </div>
                    <div class="tt-stat">Blue/green deployments · IIS · SonarQube</div>
                </div>
            </div>

            <!-- Skill Chip 3 — Data Engineering -->
            <div class="skill-chip chip-3">
                <div class="chip-inner">
                    <div class="chip-icon" style="background:#F0FDF4;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><ellipse cx="12" cy="5" rx="9" ry="3" stroke="#16A34A" stroke-width="2"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" stroke="#16A34A" stroke-width="2"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" stroke="#16A34A" stroke-width="2"/></svg>
                    </div>
                    <div>
                        <span class="chip-label">Data Engineering</span>
                        <span class="chip-sub">Python · SQL · ETL</span>
                    </div>
                </div>
                <div class="chip-bar"><div class="chip-fill" style="width:80%;background:#16A34A;"></div></div>
                <div class="chip-tooltip">
                    <div class="tt-title">Data Engineering</div>
                    SSIS pipelines processing 3M+ records/day. M.Sc. Data Engineering &amp; AI at ESILV Paris (2026).
                    <div class="tt-tags">
                        <span class="tt-tag">Python</span><span class="tt-tag">Pandas</span>
                        <span class="tt-tag">SQL</span><span class="tt-tag">ETL</span><span class="tt-tag">Spark</span>
                    </div>
                    <div class="tt-stat">ESILV Paris · Graduating 2026</div>
                </div>
            </div>

            <!-- Skill Chip 4 — AI & NLP -->
            <div class="skill-chip chip-4">
                <div class="chip-inner">
                    <div class="chip-icon" style="background:#FDF4FF;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V17a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 0 1 7-7z" stroke="#9333EA" stroke-width="2"/><path d="M9 21h6" stroke="#9333EA" stroke-width="2" stroke-linecap="round"/></svg>
                    </div>
                    <div>
                        <span class="chip-label">AI &amp; NLP</span>
                        <span class="chip-sub">BERT · LangChain</span>
                    </div>
                </div>
                <div class="chip-bar"><div class="chip-fill" style="width:74%;background:#9333EA;"></div></div>
                <div class="chip-tooltip">
                    <div class="tt-title">AI &amp; NLP</div>
                    Fine-tuned BERT for sentiment analysis. GenAI apps with LangChain + OpenAI RAG pipelines.
                    <div class="tt-tags">
                        <span class="tt-tag">BERT</span><span class="tt-tag">HuggingFace</span>
                        <span class="tt-tag">LangChain</span><span class="tt-tag">RAG</span>
                    </div>
                    <div class="tt-stat">Computer Vision · LLMs · MLflow</div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ══ TICKER ════════════════════════════════════════════════ -->
<div class="skills-ticker">
    <div class="ticker-track">
        @{var skills = new[]{"C#","ASP.NET Core","React.js","TypeScript","Azure","Python","SQL Server","BERT / NLP","Docker","Entity Framework","OAuth 2.0","JWT","LangChain","GitHub Actions","Pandas","Scikit-learn"}; }
        @foreach(var s in skills){ <div class="ticker-item"><span class="ticker-dot"></span>@s</div> }
        @foreach(var s in skills){ <div class="ticker-item"><span class="ticker-dot"></span>@s</div> }
    </div>
</div>

<!-- ══ STATS ══════════════════════════════════════════════════ -->
<div class="stats-row reveal">
    <div class="stat-card">
        <span class="stat-num">8+</span>
        <span class="stat-lbl"><span class="en-text">Years Enterprise<br>Experience</span><span class="fr-text">Ans d'expérience<br>entreprise</span></span>
    </div>
    <div class="stat-card">
        <span class="stat-num">BoA</span>
        <span class="stat-lbl"><span class="en-text">Senior Tech Lead<br>Bank of America</span><span class="fr-text">Tech Lead Senior<br>Bank of America</span></span>
    </div>
    <div class="stat-card">
        <span class="stat-num">ESILV</span>
        <span class="stat-lbl"><span class="en-text">M.Sc. Data Eng &amp; AI<br>Paris · 2026</span><span class="fr-text">Master Data Eng &amp; IA<br>Paris · 2026</span></span>
    </div>
    <div class="stat-card">
        <span class="stat-num">10+</span>
        <span class="stat-lbl"><span class="en-text">AI / ML &amp; Cloud<br>Projects Built</span><span class="fr-text">Projets IA / ML<br>&amp; Cloud réalisés</span></span>
    </div>
</div>

<div class="divider" style="margin-top:20px;"></div>

<div style="text-align:center;padding:28px 5%;">
    <a class="btn-primary reveal" asp-page="/About">
        <span class="en-text">Know More About Me →</span>
        <span class="fr-text">En savoir plus sur moi →</span>
    </a>
</div>
