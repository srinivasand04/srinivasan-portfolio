<script>
document.addEventListener("DOMContentLoaded", function () {
    var filterBar = document.getElementById("expFilter");
    if (!filterBar) return;

    filterBar.addEventListener("click", function (e) {
        var btn = e.target.closest(".ef-btn");
        if (!btn) return;

        var cat = btn.getAttribute("data-filter") || "all";

        // Update active button
        filterBar.querySelectorAll(".ef-btn").forEach(function (b) {
            b.classList.remove("active");
        });
        btn.classList.add("active");

        // Show / hide rows
        document.querySelectorAll(".exp-row").forEach(function (row) {
            var cats = (row.getAttribute("data-cat") || "").split(" ");
            if (cat === "all" || cats.indexOf(cat) !== -1) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    });
});
</script>
