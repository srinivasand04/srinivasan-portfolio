<style>
.exp-tl { display:flex; flex-direction:column; }
.exp-row { display:grid; grid-template-columns:52px 1fr; gap:0 18px; }
.exp-row.hidden { display:none; }
.exp-marker { display:flex; flex-direction:column; align-items:center; padding-top:4px; }
.exp-dot { width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
.dot-red  { background:var(--accent); box-shadow:0 0 0 4px var(--bg),0 4px 14px rgba(192,57,43,0.3); }
.dot-blue { background:#2563EB; box-shadow:0 0 0 4px var(--bg),0 4px 14px rgba(37,99,235,0.25); }
.dot-gray { background:#94a3b8; box-shadow:0 0 0 4px var(--bg); }
.dot-teal { background:#0891b2; box-shadow:0 0 0 4px var(--bg),0 4px 14px rgba(8,145,178,0.3); }
.exp-line { width:2px; flex:1; background:var(--border); margin:6px 0; min-height:24px; }
.exp-card { background:var(--card); border:1px solid var(--border); border-radius:var(--radius-lg); padding:22px 24px; margin-bottom:22px; transition:box-shadow 0.25s,transform 0.25s; }
.exp-card:hover { box-shadow:0 10px 36px rgba(0,0,0,0.08); transform:translateY(-2px); }
.exp-card-featured { border-left:3px solid var(--accent); }
.exp-card-blue { border-left:3px solid #2563EB; }
.exp-card-teal { border-left:3px solid #0891b2; }
.exp-head { display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:5px; }
.exp-role { font-size:1.02rem; font-weight:800; color:var(--text); }
.exp-period { font-size:0.67rem; font-weight:700; font-family:var(--mono); color:var(--accent); background:rgba(192,57,43,0.07); border:1px solid rgba(192,57,43,0.15); border-radius:99px; padding:3px 11px; white-space:nowrap; }
.exp-period-blue { color:#2563EB; background:rgba(37,99,235,0.07); border-color:rgba(37,99,235,0.18); }
.exp-period-gray { color:#64748b; background:rgba(100,116,139,0.07); border-color:rgba(100,116,139,0.15); }
.exp-period-teal { color:#0891b2; background:rgba(8,145,178,0.07); border-color:rgba(8,145,178,0.18); }
.exp-company { font-size:0.82rem; font-weight:600; color:var(--accent); margin-bottom:12px; }
.exp-company span { color:var(--text3); font-weight:400; }
.exp-bullets { list-style:none; display:flex; flex-direction:column; gap:7px; margin-bottom:14px; }
.exp-bullets li { display:flex; gap:9px; font-size:0.82rem; color:var(--text2); line-height:1.55; }
.exp-bullets li::before { content:'→'; color:var(--accent); flex-shrink:0; font-size:0.76rem; margin-top:2px; }
.etags { display:flex; flex-wrap:wrap; gap:5px; }
.etag { font-size:0.63rem; font-weight:700; padding:3px 10px; border-radius:6px; background:var(--bg3); color:var(--text3); }
.etag-r { background:rgba(192,57,43,0.08); color:var(--accent); }
.etag-b { background:rgba(37,99,235,0.08); color:#2563EB; }
.etag-p { background:rgba(124,58,237,0.08); color:#7c3aed; }
.etag-t { background:rgba(8,145,178,0.08); color:#0891b2; }
.impact-row { display:flex; background:var(--bg3); border-radius:10px; overflow:hidden; margin-top:14px; }
.imp-stat { flex:1; text-align:center; padding:10px 6px; border-right:1px solid var(--border); }
.imp-stat:last-child { border-right:none; }
.imp-num { display:block; font-family:var(--mono); font-size:1.05rem; font-weight:700; color:var(--accent); }
.imp-lbl { font-size:0.59rem; color:var(--text3); font-weight:600; text-transform:uppercase; letter-spacing:0.04em; }
.edu-pills { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
.edu-pill { font-size:0.68rem; font-weight:700; padding:3px 11px; border-radius:99px; background:rgba(8,145,178,0.08); color:#0891b2; border:1px solid rgba(8,145,178,0.18); }
/* Filter bar */
.exp-filter { display:flex; gap:8px; flex-wrap:wrap; margin:28px 0 32px; }
.ef-btn { display:inline-flex; align-items:center; gap:7px; padding:8px 18px; border-radius:99px; border:1.5px solid var(--border); background:var(--card); color:var(--text2); font-size:0.78rem; font-weight:700; font-family:var(--mono); cursor:pointer; transition:all 0.2s; user-select:none; }
.ef-btn:hover { border-color:var(--accent); color:var(--accent); }
.ef-btn.active { background:var(--accent); color:#fff; border-color:var(--accent); }
.ef-icon { font-size:0.85rem; }
.ef-count { font-size:0.65rem; font-weight:800; background:rgba(255,255,255,0.22); border-radius:99px; padding:1px 7px; min-width:18px; text-align:center; }
.ef-btn:not(.active) .ef-count { background:var(--bg3); color:var(--text3); }
@@media(max-width:640px){ .exp-row{grid-template-columns:34px 1fr;gap:0 12px;} .exp-dot{width:30px;height:30px;font-size:0.9rem;} .ef-btn{padding:6px 13px;font-size:0.72rem;} }
</style>

